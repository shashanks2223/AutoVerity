# API Server Configuration
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=uploads

# Database Configurations (PostgreSQL)
# Note: For Docker Compose, the db host is 'db' instead of 'localhost'
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/media_processor

# Celery Broker Configurations (Redis)
# Note: For Docker Compose, the redis host is 'redis' instead of 'localhost'
REDIS_URL=redis://localhost:6379/0

# Processing Limits and Thresholds
MAX_UPLOAD_SIZE=10485760
DUPLICATE_THRESHOLD=4
BLUR_THRESHOLD=100.0
BRIGHTNESS_THRESHOLD=70.0

# Gemini API Key for OCR and quality analysis fallback
GEMINI_API_KEY=your_gemini_api_key_here
